rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: transactions
    // Document ID: auto-generated
    // Fields:
    //   - type: string (income/expense)
    //   - amount: number
    //   - category: string
    //   - date: timestamp
    //   - description: string (optional)
    //   - uid: string
    //
    // Collection: categories
    // Document ID: auto-generated
    // Fields:
    //   - name: string
    //   - type: string (income/expense)
    //   - icon: string
    //   - uid: string
    //
    // Collection: budgets
    // Document ID: auto-generated
    // Fields:
    //   - category: string
    //   - amount: number
    //   - period: string
    //   - uid: string
    //
    // Collection: debts
    // Document ID: auto-generated
    // Fields:
    //   - type: string (borrow/lend)
    //   - person: string
    //   - amount: number
    //   - dueDate: timestamp (optional)
    //   - status: string (pending/paid)
    //   - uid: string
    //   - description: string
    //   - date: timestamp
    //
    // Collection: challenges
    // Document ID: auto-generated
    // Fields:
    //   - title: string
    //   - description: string
    //   - targetAmount: number
    //   - currentAmount: number
    //   - startDate: timestamp
    //   - endDate: timestamp
    //   - type: string (no-spend/savings/budget)
    //   - status: string (active/completed/failed)
    //   - uid: string
    //
    // Collection: emis
    // Document ID: auto-generated
    // Fields:
    //   - title: string
    //   - source: string
    //   - totalAmount: number
    //   - principalAmount: number
    //   - interestAmount: number
    //   - monthlyInstallment: number
    //   - tenure: number
    //   - paidInstallments: number
    //   - startDate: timestamp
    //   - nextDueDate: timestamp
    //   - status: string (active/completed/cancelled)
    //   - uid: string
    //   - description: string (optional)
    //
    // Collection: emiPayments
    // Document ID: auto-generated
    // Fields:
    //   - emiId: string
    //   - amount: number
    //   - date: timestamp
    //   - installmentNumber: number
    //   - uid: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isPositive(field) {
      return request.resource.data[field] is number && request.resource.data[field] > 0;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidTransaction(data) {
      return hasRequiredFields(['type', 'amount', 'category', 'date', 'uid']) &&
             data.type in ['income', 'expense'] &&
             data.amount is number && data.amount > 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 50 &&
             data.date is timestamp &&
             data.uid == request.auth.uid;
    }

    function isValidCategory(data) {
      return hasRequiredFields(['name', 'type', 'icon', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             data.type in ['income', 'expense'] &&
             data.icon is string &&
             data.uid == request.auth.uid;
    }

    function isValidBudget(data) {
      return hasRequiredFields(['category', 'amount', 'period', 'uid']) &&
             data.category is string &&
             data.amount is number && data.amount > 0 &&
             data.period is string &&
             data.uid == request.auth.uid;
    }

    function isValidDebt(data) {
      return hasRequiredFields(['type', 'person', 'amount', 'status', 'uid', 'date']) &&
             data.type in ['borrow', 'lend'] &&
             data.person is string && data.person.size() > 0 && data.person.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'paid'] &&
             data.uid == request.auth.uid &&
             data.date is timestamp &&
             (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp) &&
             (!('description' in data) || data.description == null || data.description is string) &&
             (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string) &&
             (!('paidAmount' in data) || data.paidAmount is number);
    }

    function isValidChallenge(data) {
      return hasRequiredFields(['title', 'description', 'targetAmount', 'currentAmount', 'startDate', 'endDate', 'type', 'status', 'uid']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.description is string &&
             data.targetAmount is number && data.targetAmount >= 0 &&
             data.currentAmount is number && data.currentAmount >= 0 &&
             data.startDate is timestamp &&
             data.endDate is timestamp &&
             data.type in ['no-spend', 'savings', 'budget'] &&
             data.status in ['active', 'completed', 'failed'] &&
             data.uid == request.auth.uid;
    }

    function isValidEMI(data) {
      return hasRequiredFields(['title', 'source', 'totalAmount', 'principalAmount', 'interestAmount', 'monthlyInstallment', 'tenure', 'paidInstallments', 'startDate', 'nextDueDate', 'status', 'uid']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.source is string && data.source.size() > 0 && data.source.size() < 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.principalAmount is number && data.principalAmount >= 0 &&
             data.interestAmount is number && data.interestAmount >= 0 &&
             data.monthlyInstallment is number && data.monthlyInstallment >= 0 &&
             data.tenure is number && data.tenure > 0 &&
             data.paidInstallments is number && data.paidInstallments >= 0 &&
             data.startDate is timestamp &&
             data.nextDueDate is timestamp &&
             data.status in ['active', 'completed', 'cancelled'] &&
             data.uid == request.auth.uid &&
             (!('description' in data) || data.description is string);
    }

    function isValidEMIPayment(data) {
      return hasRequiredFields(['emiId', 'amount', 'date', 'installmentNumber', 'uid']) &&
             data.emiId is string &&
             data.amount is number && data.amount > 0 &&
             data.date is timestamp &&
             data.installmentNumber is number && data.installmentNumber > 0 &&
             data.uid == request.auth.uid;
    }

    function isValidDebtPayment(data) {
      return hasRequiredFields(['debtId', 'amount', 'type', 'date', 'uid']) &&
             data.debtId is string &&
             data.amount is number && data.amount > 0 &&
             data.type in ['pay', 'add'] &&
             data.date is timestamp &&
             data.uid == request.auth.uid &&
             (!('note' in data) || data.note == null || data.note is string) &&
             (!('person' in data) || data.person == null || data.person is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /transactions/{transactionId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidTransaction(request.resource.data);
      allow update: if isDocOwner() && isValidTransaction(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /categories/{categoryId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidCategory(request.resource.data);
      allow update: if isDocOwner() && isValidCategory(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /budgets/{budgetId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidBudget(request.resource.data);
      allow update: if isDocOwner() && isValidBudget(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /debts/{debtId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidDebt(request.resource.data);
      allow update: if isDocOwner() && isValidDebt(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /challenges/{challengeId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidChallenge(request.resource.data);
      allow update: if isDocOwner() && isValidChallenge(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /emis/{emiId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidEMI(request.resource.data);
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isValidEMI(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /emiPayments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidEMIPayment(request.resource.data);
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isValidEMIPayment(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /debtPayments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidDebtPayment(request.resource.data);
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isValidDebtPayment(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /payment_profiles/{profileId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
    }

    match /payment_requests/{requestId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
    }

    match /savings_goals/{goalId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}

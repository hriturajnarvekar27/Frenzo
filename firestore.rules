rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Authentication and ownership helpers
    // ---------------------------------------------------------------

    // A valid user must be signed in with a non-anonymous provider.
    function isRegisteredUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isRegisteredUser() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isRegisteredUser()
        && resource.data.uid == request.auth.uid;
    }

    function uidIsCurrentUser(data) {
      return data.keys().hasAll(['uid'])
        && data.uid == request.auth.uid;
    }

    function uidIsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid;
    }

    function ownsEmi(emiId) {
      return exists(/databases/$(database)/documents/emis/$(emiId))
        && get(/databases/$(database)/documents/emis/$(emiId)).data.uid
          == request.auth.uid;
    }

    function ownsDebt(debtId) {
      return exists(/databases/$(database)/documents/debts/$(debtId))
        && get(/databases/$(database)/documents/debts/$(debtId)).data.uid
          == request.auth.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ---------------------------------------------------------------
    // Domain validators
    // ---------------------------------------------------------------

    function isValidTransaction(data) {
      return data.keys().hasAll(['type', 'amount', 'category', 'date', 'uid'])
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount > 0
        && data.category is string
        && data.category.size() > 0 && data.category.size() < 50
        && data.date is timestamp
        && data.uid == request.auth.uid;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'type', 'icon', 'uid'])
        && data.name is string
        && data.name.size() > 0 && data.name.size() < 50
        && data.type in ['income', 'expense']
        && data.icon is string
        && data.uid == request.auth.uid;
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['category', 'amount', 'period', 'uid'])
        && data.category is string
        && data.amount is number && data.amount > 0
        && data.period is string
        && data.uid == request.auth.uid;
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['type', 'person', 'amount', 'status', 'uid', 'date'])
        && data.type in ['borrow', 'lend']
        && data.person is string
        && data.person.size() > 0 && data.person.size() < 100
        && data.amount is number && data.amount > 0
        && data.status in ['pending', 'paid']
        && data.uid == request.auth.uid
        && data.date is timestamp
        && (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp)
        && (!('description' in data) || data.description == null || data.description is string)
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string)
        && (!('paidAmount' in data) || data.paidAmount is number);
    }

    function isValidChallenge(data) {
      return data.keys().hasAll([
          'title', 'description', 'targetAmount', 'currentAmount',
          'startDate', 'endDate', 'type', 'status', 'uid'
        ])
        && data.title is string
        && data.title.size() > 0 && data.title.size() < 100
        && data.description is string
        && data.targetAmount is number && data.targetAmount >= 0
        && data.currentAmount is number && data.currentAmount >= 0
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.type in ['no-spend', 'savings', 'budget']
        && data.status in ['active', 'completed', 'failed']
        && data.uid == request.auth.uid;
    }

    function isValidEMI(data) {
      return data.keys().hasAll([
          'title', 'source', 'totalAmount', 'principalAmount',
          'interestAmount', 'monthlyInstallment', 'tenure',
          'paidInstallments', 'startDate', 'nextDueDate',
          'status', 'uid'
        ])
        && data.title is string
        && data.title.size() > 0 && data.title.size() < 100
        && data.source is string
        && data.source.size() > 0 && data.source.size() < 100
        && data.totalAmount is number && data.totalAmount >= 0
        && data.principalAmount is number && data.principalAmount >= 0
        && data.interestAmount is number && data.interestAmount >= 0
        && data.monthlyInstallment is number && data.monthlyInstallment >= 0
        && data.tenure is number && data.tenure > 0
        && data.paidInstallments is number && data.paidInstallments >= 0
        && data.startDate is timestamp
        && data.nextDueDate is timestamp
        && data.status in ['active', 'completed', 'cancelled']
        && data.uid == request.auth.uid
        && (!('description' in data) || data.description is string);
    }

    function isValidEMIPayment(data) {
      return data.keys().hasAll([
          'emiId', 'amount', 'date', 'installmentNumber', 'uid'
        ])
        && data.emiId is string && data.emiId.size() > 0
        && data.amount is number && data.amount > 0
        && data.date is timestamp
        && data.installmentNumber is number && data.installmentNumber > 0
        && data.uid == request.auth.uid;
    }

    function isValidDebtPayment(data) {
      return data.keys().hasAll(['debtId', 'amount', 'type', 'date', 'uid'])
        && data.debtId is string && data.debtId.size() > 0
        && data.amount is number && data.amount > 0
        && data.type in ['pay', 'add']
        && data.date is timestamp
        && data.uid == request.auth.uid
        && (!('note' in data) || data.note == null || data.note is string)
        && (!('person' in data) || data.person == null || data.person is string);
    }

    // ---------------------------------------------------------------
    // Core financial collections
    // ---------------------------------------------------------------

    match /transactions/{transactionId} {
      allow read, delete: if isDocOwner();
      allow create: if isRegisteredUser()
        && isValidTransaction(request.resource.data);
      allow update: if isDocOwner()
        && isValidTransaction(request.resource.data)
        && uidIsUnchanged();
    }

    match /categories/{categoryId} {
      allow read, delete: if isDocOwner();
      allow create: if isRegisteredUser()
        && isValidCategory(request.resource.data);
      allow update: if isDocOwner()
        && isValidCategory(request.resource.data)
        && uidIsUnchanged();
    }

    match /budgets/{budgetId} {
      allow read, delete: if isDocOwner();
      allow create: if isRegisteredUser()
        && isValidBudget(request.resource.data);
      allow update: if isDocOwner()
        && isValidBudget(request.resource.data)
        && uidIsUnchanged();
    }

    match /debts/{debtId} {
      allow read, delete: if isDocOwner();
      allow create: if isRegisteredUser()
        && isValidDebt(request.resource.data);
      allow update: if isDocOwner()
        && isValidDebt(request.resource.data)
        && uidIsUnchanged();
    }

    match /challenges/{challengeId} {
      allow read, delete: if isDocOwner();
      allow create: if isRegisteredUser()
        && isValidChallenge(request.resource.data);
      allow update: if isDocOwner()
        && isValidChallenge(request.resource.data)
        && uidIsUnchanged();
    }

    // ---------------------------------------------------------------
    // EMI records and payments
    // ---------------------------------------------------------------

    match /emis/{emiId} {
      allow read, delete: if isDocOwner();
      allow create: if isRegisteredUser()
        && isValidEMI(request.resource.data);
      allow update: if isDocOwner()
        && isValidEMI(request.resource.data)
        && uidIsUnchanged();
    }

    match /emiPayments/{paymentId} {
      // Payment history remains readable by its owner even if its EMI
      // parent is later deleted.
      allow read, delete: if isDocOwner();

      // A new payment must refer to an EMI owned by the same user.
      allow create: if isRegisteredUser()
        && isValidEMIPayment(request.resource.data)
        && ownsEmi(request.resource.data.emiId);

      // Keep both ownership and the parent reference immutable.
      // No parent lookup on update so existing history is manageable
      // even if the parent EMI has subsequently been deleted.
      allow update: if isDocOwner()
        && isValidEMIPayment(request.resource.data)
        && uidIsUnchanged()
        && request.resource.data.emiId == resource.data.emiId;
    }

    // ---------------------------------------------------------------
    // Debt payment records
    // ---------------------------------------------------------------

    match /debtPayments/{paymentId} {
      allow read, delete: if isDocOwner();

      allow create: if isRegisteredUser()
        && isValidDebtPayment(request.resource.data)
        && ownsDebt(request.resource.data.debtId);

      // Preserve historical payment records if the parent debt is
      // deleted, while preventing ownership or parent-ID changes.
      allow update: if isDocOwner()
        && isValidDebtPayment(request.resource.data)
        && uidIsUnchanged()
        && request.resource.data.debtId == resource.data.debtId;
    }

    // ---------------------------------------------------------------
    // User-owned supporting collections
    // ---------------------------------------------------------------

    match /payment_profiles/{profileId} {
      allow read, delete: if isDocOwner();

      allow create: if isRegisteredUser()
        && uidIsCurrentUser(request.resource.data);

      allow update: if isDocOwner()
        && uidIsCurrentUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
    }

    match /payment_requests/{requestId} {
      allow read, delete: if isDocOwner();

      allow create: if isRegisteredUser()
        && uidIsCurrentUser(request.resource.data);

      allow update: if isDocOwner()
        && uidIsCurrentUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
    }

    match /savings_goals/{goalId} {
      allow read, delete: if isDocOwner();

      allow create: if isRegisteredUser()
        && uidIsCurrentUser(request.resource.data);

      allow update: if isDocOwner()
        && uidIsCurrentUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
    }

    // User profile documents are accessible only by their owner.
    // This preserves the app's existing profile document structure.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
